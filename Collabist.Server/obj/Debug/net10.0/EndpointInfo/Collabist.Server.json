  "components": {
    "schemas": {
      "AddDataSourceRequest": {
        "type": "object",
        "properties": {
          "knowledgeBaseId": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "$ref": "#/components/schemas/DataSourceType"
          },
          "ignoreFilePath": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChatRequest": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateKnowledgeBaseRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DataSourceType": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "OnboardingRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "initialKnowledgeBaseName": {
            "type": "string",
            "nullable": true
          },
          "allowLocalModels": {
            "type": "boolean"
          },
          "allowCompanyCloud": {
            "type": "boolean"
          },
          "allowOwnApi": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "OnboardingResponse": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "knowledgeBaseId": {
            "type": "string",
            "format": "uuid"
          },
          "success": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "OnboardingStatusResponse": {
        "type": "object",
        "properties": {
          "isOnboarded": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Chat"
    },
    {
      "name": "DataSource"
    },
    {
      "name": "Indexing"
    },
    {
